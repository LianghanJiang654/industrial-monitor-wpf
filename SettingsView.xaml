<UserControl x:Class="FactorialApp.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="30" Background="#1E1E2E">
        <TextBlock Text="Alarm Settings" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Temperature Alarm Threshold (°C):" Foreground="#888899" FontSize="14"/>
        <TextBox Text="{Binding TemperatureThreshold}" Height="35" FontSize="16" Margin="0,5,0,0"/>
    </StackPanel>
</UserControl>
