<UserControl x:Class="FactorialApp.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FactorialApp"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <local:TemperatureColorConverter x:Key="TempColorConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="30" Background="#1E1E2E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#2A2A3D" CornerRadius="10"
                Padding="15" Margin="0,5">
            <StackPanel>
                <TextBlock Text="TEMPERATURE" Foreground="#888899" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="{Binding Temperature}" FontSize="32" FontWeight="Bold"
                           Foreground="{Binding TemperatureColor}"/>
                <TextBlock Text="°C" Foreground="#888899" FontSize="14"/>
                <lvc:CartesianChart Series="{Binding TemperatureSeries}" Height="180"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#2A2A3D" CornerRadius="10"
                Padding="15" Margin="0,5">
            <StackPanel>
                <TextBlock Text="HUMIDITY" Foreground="#888899" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="{Binding Humidity}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="%" Foreground="#888899" FontSize="14"/>
                <lvc:CartesianChart Series="{Binding HumiditySeries}" Height="180"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#2A2A3D" CornerRadius="10"
                Padding="15" Margin="0,5">
            <StackPanel>
                <TextBlock Text="PRESSURE" Foreground="#888899" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="{Binding Pressure}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="hPa" Foreground="#888899" FontSize="14"/>
                <lvc:CartesianChart Series="{Binding PressureSeries}" Height="180"/>
            </StackPanel>
        </Border>

        <Button Content="Start Monitoring" Grid.Row="3" Grid.Column="0"
                Command="{Binding StartCommand}" Height="40" Margin="0,20,5,0" FontSize="14"/>
        <Button Content="Stop" Grid.Row="3" Grid.Column="1"
                Command="{Binding StopCommand}" Height="40" Margin="5,20,0,0" FontSize="14"/>

        <Label Content="Motor Status:" Grid.Row="4" Grid.Column="0"
               Foreground="White" FontSize="16" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding MotorStatus}" Grid.Row="4" Grid.Column="1"
                   Foreground="LightGreen" FontSize="18" VerticalAlignment="Center"/>
       <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Background="#2A2A3D" CornerRadius="10"
        Padding="15" Margin="0,10">
    <StackPanel>
        <TextBlock Text="AXIS CONTROL" Foreground="#888899" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- X轴 -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="X" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding AxisXPosition}" Foreground="White" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" Text="{Binding TargetX}" Height="26" FontSize="12"/>
            <Button Grid.Column="3" Content="Go" Command="{Binding MoveXCommand}" Height="26" Margin="5,0"/>
            <Button Grid.Column="4" Content="◀" Width="30" Height="26"
                    PreviewMouseDown="JogX_MinusDown" PreviewMouseUp="JogX_Up"/>
            <Button Grid.Column="5" Content="▶" Width="30" Height="26" Margin="3,0,0,0"
                    PreviewMouseDown="JogX_PlusDown" PreviewMouseUp="JogX_Up"/>
        </Grid>

        <!-- Y轴 -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Y" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding AxisYPosition}" Foreground="White" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" Text="{Binding TargetY}" Height="26" FontSize="12"/>
            <Button Grid.Column="3" Content="Go" Command="{Binding MoveYCommand}" Height="26" Margin="5,0"/>
            <Button Grid.Column="4" Content="◀" Width="30" Height="26"
                    PreviewMouseDown="JogY_MinusDown" PreviewMouseUp="JogY_Up"/>
            <Button Grid.Column="5" Content="▶" Width="30" Height="26" Margin="3,0,0,0"
                    PreviewMouseDown="JogY_PlusDown" PreviewMouseUp="JogY_Up"/>
        </Grid>

        <!-- Z轴 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Z" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding AxisZPosition}" Foreground="White" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" Text="{Binding TargetZ}" Height="26" FontSize="12"/>
            <Button Grid.Column="3" Content="Go" Command="{Binding MoveZCommand}" Height="26" Margin="5,0"/>
            <Button Grid.Column="4" Content="◀" Width="30" Height="26"
                    PreviewMouseDown="JogZ_MinusDown" PreviewMouseUp="JogZ_Up"/>
            <Button Grid.Column="5" Content="▶" Width="30" Height="26" Margin="3,0,0,0"
                    PreviewMouseDown="JogZ_PlusDown" PreviewMouseUp="JogZ_Up"/>
        </Grid>
    </StackPanel>
</Border>
        <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Background="#2A2A3D" CornerRadius="10"
                Padding="15" Margin="0,10">
            <StackPanel>
                <TextBlock Text="ACTIVITY LOG" Foreground="#888899" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox ItemsSource="{Binding LogEntries}" Height="150" Background="#1E1E2E"
                         Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Background="#2A2A3D" CornerRadius="10"
                Padding="15" Margin="0,10">
            <StackPanel>
                <TextBlock Text="ALARMS" Foreground="#888899" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox ItemsSource="{Binding Alarms}" Height="150" Background="#1E1E2E"
                         Foreground="White" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="#888899" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="Orange" Margin="10,0"/>
                                <Button Grid.Column="3" Content="Ack" Command="{Binding DataContext.AcknowledgeAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Width="50" Height="24" FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
        <Button Content="Toggle Motor" Grid.Row="5" Grid.ColumnSpan="2"
                Command="{Binding ToggleMotorCommand}" Height="35" Margin="0,10,0,0"/>
    </Grid>
    </ScrollViewer>
</UserControl>

