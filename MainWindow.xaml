<Window x:Class="FactorialApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Machine Vision Inspection System"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#071321">

    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#0B1B2B"/>
        <SolidColorBrush x:Key="Border" Color="#15537B"/>
        <SolidColorBrush x:Key="Cyan" Color="#16C8FF"/>
        <SolidColorBrush x:Key="Blue" Color="#1687FF"/>
        <SolidColorBrush x:Key="Green" Color="#16D86B"/>
        <SolidColorBrush x:Key="Red" Color="#FF4D5A"/>
        <SolidColorBrush x:Key="Orange" Color="#FFAA2C"/>
        <SolidColorBrush x:Key="Purple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="Text" Color="#EDF6FF"/>
        <SolidColorBrush x:Key="SubText" Color="#89A3B8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#102B42"/>
            <Setter Property="BorderBrush" Value="#17628E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#086DD7"/>
            <Setter Property="BorderBrush" Value="#159CFF"/>
        </Style>

        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#087A48"/>
            <Setter Property="BorderBrush" Value="#16D86B"/>
        </Style>

        <Style x:Key="PurpleButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#5631B8"/>
            <Setter Property="BorderBrush" Value="#8B5CF6"/>
        </Style>

        <Style x:Key="RedButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#8B2430"/>
            <Setter Property="BorderBrush" Value="#FF4D5A"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#071725"/>
            <Setter Property="BorderBrush" Value="#245473"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#04101C"
                BorderBrush="#143A54"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="6" Background="#0876C9">
                        <TextBlock Text="◎"
                                   FontSize="21"
                                   Foreground="#24D3FF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="MACHINE VISION"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="INSPECTION SYSTEM"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource Cyan}"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="9"
                             Height="9"
                             Fill="{StaticResource Green}"
                             Margin="0,0,7,0"/>
                    <TextBlock Text="SYSTEM READY"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="1" Margin="12,10,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,8,0">
                <StackPanel>
                    <GroupBox Header="▣  CAMERA" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Status" Foreground="{StaticResource SubText}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CameraStatusText}"
                                           Foreground="{StaticResource Cyan}"
                                           FontWeight="SemiBold"/>
                            </Grid>

                            <Button Content="Connect"
                                    Style="{StaticResource BlueButton}"
                                    Command="{Binding CameraConnectCommand}"/>

                            <Button Content="Disconnect"
                                    Style="{StaticResource ButtonBase}"
                                    Command="{Binding CameraDisconnectCommand}"/>

                            <TextBlock Text="Exposure (µs)" Margin="0,8,0,2"/>
                            <Slider Minimum="100"
                                    Maximum="20000"
                                    Value="{Binding CameraExposureUs, Mode=TwoWay}"
                                    TickFrequency="100"/>

                            <TextBlock Text="{Binding CameraExposureUs, StringFormat={}{0:F0} µs}"
                                       Foreground="{StaticResource SubText}"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Gain" Margin="0,8,0,2"/>
                            <Slider Minimum="0"
                                    Maximum="10"
                                    Value="{Binding CameraGain, Mode=TwoWay}"
                                    TickFrequency="0.5"/>

                            <TextBlock Text="{Binding CameraGain, StringFormat={}{0:F1}}"
                                       Foreground="{StaticResource SubText}"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Fault Simulation" Margin="0,8,0,3"/>
                            <ComboBox ItemsSource="{Binding CameraFaultModes}"
                                      SelectedItem="{Binding CameraFaultMode, Mode=TwoWay}"
                                      Height="29"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="▶ Live"
                                        Style="{StaticResource GreenButton}"
                                        Command="{Binding CameraLiveCommand}"/>

                                <Button Grid.Column="1"
                                        Content="■ Stop Live"
                                        Style="{StaticResource ButtonBase}"
                                        Command="{Binding CameraStopLiveCommand}"/>
                            </Grid>

                            <Button Content="●  Trigger Once"
                                    Style="{StaticResource PurpleButton}"
                                    Command="{Binding DetectVisionCommand}"
                                    Margin="2,6,2,2"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="◉  VISION">
                        <StackPanel Margin="8">
                            <Button Content="Blob Analysis"
                                    Style="{StaticResource PurpleButton}"/>
                            <Button Content="Template Match"
                                    Style="{StaticResource ButtonBase}"/>
                            <Button Content="Line Detection"
                                    Style="{StaticResource ButtonBase}"/>
                            <Button Content="Circle Detection"
                                    Style="{StaticResource ButtonBase}"/>
                            <Button Content="9-Point Calibration"
                                    Style="{StaticResource ButtonBase}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- CENTER -->
            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="148"/>
                </Grid.RowDefinitions>

                <GroupBox Header="▣  INSPECTION IMAGE"
                          Grid.Row="0"
                          Margin="0,0,0,8">
                    <Border Margin="8"
                            Background="#01080E"
                            BorderBrush="#17445E"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Image Source="{Binding VisionImage}"
                                   Stretch="Uniform"/>

                            <TextBlock Text="NO IMAGE - CONNECT CAMERA AND TRIGGER"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#354E61"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VisionImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="10"
                                    Background="#B005101B"
                                    BorderBrush="#17445E"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="7">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveRecipeName, StringFormat=Recipe: {0}}"
                                               Foreground="{StaticResource Cyan}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ProductCode, StringFormat=Product: {0}}"
                                               Foreground="{StaticResource SubText}"
                                               FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </GroupBox>

                <GroupBox Header="◉  PLC HANDSHAKE"
                          Grid.Row="1">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="42"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="7">
                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="12" Height="12">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#36546A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlcReady}" Value="True">
                                                    <Setter Property="Fill" Value="#16D86B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="Ready" Margin="0,5,0,0" FontSize="11"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="12" Height="12">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#36546A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlcStart}" Value="True">
                                                    <Setter Property="Fill" Value="#16C8FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="Start" Margin="0,5,0,0" FontSize="11"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="12" Height="12">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#36546A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlcTrigger}" Value="True">
                                                    <Setter Property="Fill" Value="#8B5CF6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="Trigger" Margin="0,5,0,0" FontSize="11"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="12" Height="12">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#36546A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlcBusy}" Value="True">
                                                    <Setter Property="Fill" Value="#FFAA2C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="Busy" Margin="0,5,0,0" FontSize="11"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="12" Height="12">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#36546A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlcDone}" Value="True">
                                                    <Setter Property="Fill" Value="#1687FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="Done" Margin="0,5,0,0" FontSize="11"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="12" Height="12">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#36546A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlcPass}" Value="True">
                                                    <Setter Property="Fill" Value="#16D86B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="Pass" Margin="0,5,0,0" FontSize="11"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="12" Height="12">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#36546A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlcFail}" Value="True">
                                                    <Setter Property="Fill" Value="#FF4D5A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="Fail" Margin="0,5,0,0" FontSize="11"/>
                            </StackPanel>
                        </UniformGrid>

                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ToolTip>
                                <TextBlock Text="{Binding HandshakeState, StringFormat=Handshake: {0}}"/>
                            </Grid.ToolTip>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="PLC CYCLE"
                                    Command="{Binding StartPlcCycleCommand}"
                                    Style="{StaticResource BlueButton}"/>

                            <Button Grid.Column="1"
                                    Content="AUTO START"
                                    Command="{Binding AutoStartCommand}"
                                    Style="{StaticResource GreenButton}"/>

                            <Button Grid.Column="2"
                                    Content="AUTO STOP"
                                    Command="{Binding AutoStopCommand}"
                                    Style="{StaticResource RedButtonStyle}"/>
                        </Grid>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- RIGHT -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="♛  VISION RESULT"
                              Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <Border Background="#063C23"
                                    BorderBrush="#09854B"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="8">
                                <TextBlock Text="{Binding VisionStatus}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Green}"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <ItemsControl ItemsSource="{Binding VisionMarks}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3"
                                                Padding="8"
                                                Background="#071725"
                                                BorderBrush="#17445E"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="X: "/>
                                                    <Run Text="{Binding X, StringFormat={}{0:F2}}"/>
                                                    <Run Text="    Y: "/>
                                                    <Run Text="{Binding Y, StringFormat={}{0:F2}}"/>
                                                </TextBlock>

                                                <TextBlock>
                                                    <Run Text="Angle: "/>
                                                    <Run Text="{Binding Angle, StringFormat={}{0:F2}}"/>
                                                    <Run Text="°    Area: "/>
                                                    <Run Text="{Binding Area, StringFormat={}{0:F2}}"/>
                                                </TextBlock>

                                                <TextBlock Foreground="{StaticResource Green}">
                                                    <Run Text="Machine X: "/>
                                                    <Run Text="{Binding Machine_X, StringFormat={}{0:F2}}"/>
                                                    <Run Text=" mm"/>
                                                </TextBlock>

                                                <TextBlock Foreground="{StaticResource Green}">
                                                    <Run Text="Machine Y: "/>
                                                    <Run Text="{Binding Machine_Y, StringFormat={}{0:F2}}"/>
                                                    <Run Text=" mm"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="⚙  PARAMETERS">
                        <StackPanel Margin="8">
                            <TextBlock Text="Test Image" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding VisionImageNames}" SelectedItem="{Binding VisionImageName, Mode=TwoWay}" Height="30" Margin="0,0,0,8"/>
                            <TextBlock Text="Threshold Mode" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding VisionThresholdModes}" SelectedItem="{Binding VisionThresholdMode, Mode=TwoWay}" Height="30" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="Threshold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding VisionThreshold, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="Min Area" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding VisionMinArea, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="Max Area" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding VisionMaxArea, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                            <Separator Margin="0,4,0,8" Background="#245473"/>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="Position Tol (px)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding VisionPositionTolerance, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="Angle Tol (deg)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding VisionAngleTolerance, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="Area Tol (%)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding VisionAreaTolerancePercent, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                            <TextBlock Text="Inspection rule: Count → Position → Angle → Area" Foreground="{StaticResource SubText}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="▤  PRODUCT RECIPE" Margin="0,8,0,0">
                        <StackPanel Margin="8">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Product Code" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="New Recipe Name" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding NewRecipeName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Button Content="SAVE CURRENT RECIPE"
                                    Style="{StaticResource BlueButton}"
                                    Command="{Binding SaveRecipeCommand}"/>

                            <TextBlock Text="Saved Recipes" Margin="0,7,0,3"
                                       Foreground="{StaticResource SubText}"/>

                            <ItemsControl ItemsSource="{Binding Recipes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}"
                                                Command="{Binding DataContext.LoadRecipeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ButtonBase}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="⚠  ALARM / DIAGNOSTICS" Margin="0,8,0,0">
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding LastAlarmCode, StringFormat=Alarm Code: {0}}"
                                       Foreground="{StaticResource Orange}"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>

                            <Border Background="#2A1118"
                                    BorderBrush="#8B2430"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="8">
                                <TextBlock Text="{Binding SystemAlarmText}"
                                           Foreground="{StaticResource Red}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Button Content="RESET ALARM"
                                    Style="{StaticResource RedButtonStyle}"
                                    Command="{Binding ResetVisionAlarmCommand}"
                                    Margin="2,8,2,2"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- BOTTOM -->
        <Grid Grid.Row="2" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="▣  DETECTION LOG"
                      Margin="0,0,8,0">
                <ListBox ItemsSource="{Binding LogEntries}"
                         Margin="8"
                         Background="#05101B"
                         Foreground="#CDE3F2"
                         BorderBrush="#173C55"
                         FontSize="11"/>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="▣  PRODUCTION STATISTICS">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="CYCLE"
                                   Foreground="{StaticResource SubText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CycleCount}"
                                   FontSize="24"
                                   Foreground="{StaticResource Blue}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="PASS"
                                   Foreground="{StaticResource SubText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PassCount}"
                                   FontSize="24"
                                   Foreground="{StaticResource Green}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="FAIL"
                                   Foreground="{StaticResource SubText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding FailCount}"
                                   FontSize="24"
                                   Foreground="{StaticResource Red}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="AUTO"
                                   Foreground="{StaticResource SubText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding IsAutoRunning}"
                                   FontSize="18"
                                   Foreground="{StaticResource Cyan}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- STATUS -->
        <Border Grid.Row="3"
                Background="#04101C"
                BorderBrush="#143A54"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding HandshakeState, StringFormat=Handshake: {0}}"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SubText}"
                       FontSize="11"/>
        </Border>
    </Grid>
</Window>
