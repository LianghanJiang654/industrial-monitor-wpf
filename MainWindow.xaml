<Window x:Class="FactorialApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Industrial Monitor" Height="800" Width="500"
        Background="#1E1E2E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Background="#15151F">
            <Button Content="Monitor" Command="{Binding ShowMonitorCommand}" Width="100" Margin="10"/>
            <Button Content="Settings" Command="{Binding ShowSettingsCommand}" Width="100" Margin="10"/>
        </StackPanel>

        <ContentControl Content="{Binding CurrentView}" Grid.Row="1"/>
    </Grid>
</Window>